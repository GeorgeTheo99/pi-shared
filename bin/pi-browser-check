#!/usr/bin/env python3
"""Read-only optional browser-worker readiness check (Python standard library).

Exit 0 + READY: authenticated tools/list advertises exactly browser_fetch and
browser_inspect. Exit 0 + DISABLED: browserWorkerEnabled=false explicitly opts
out of this separate capability. Exit 2 + WARN: invalid configuration or a
selected worker whose token/backend is unavailable.
No browser tools are executed, no public pages fetched, and no state is written.
Configuration matches extensions/pi-browser-capture/src/browser-worker.ts:
Environment overrides BROWSER_WORKER_MCP_URL / BROWSER_WORKER_MCP_TOKEN_FILE,
then browserWorkerMcpUrl / browserWorkerTokenFile in ~/.pi/research/config.json.
No proxies or redirects.
"""

import argparse
import http.client
import json
import os
from pathlib import Path
import re
import signal
import sys
import urllib.parse
import uuid


sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "extensions/dev-doctor"))
from doctor_common import capability, read_bytes, read_json, timeout_value, timestamp


class BrowserError(ValueError):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


GUIDANCE = (
    "Configure BROWSER_WORKER_MCP_URL (default http://127.0.0.1:8890/mcp) and "
    "BROWSER_WORKER_MCP_TOKEN_FILE (default ~/srv/browser-worker/shared/tokens/pi-production) "
    "for custom deployments, or install/repair browser-worker through pi-setup or browser-worker/install.sh. "
    "The installer creates a local production token automatically; no external API key is needed. "
    "See pi-shared/extensions/pi-browser-capture/README.md; "
    "restart Pi or /reload after setup. app_* and web_search/web_fetch are independent."
)


def worker_config():
    path = Path.home() / ".pi/research/config.json"
    try:
        config = read_json(path)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, RuntimeError):
        raise ValueError("Cannot read browser-worker selection from ~/.pi/research/config.json; fix the research configuration") from None
    if not isinstance(config, dict):
        raise ValueError("Research configuration must be an object")
    enabled = config.get("browserWorkerEnabled", True)
    if not isinstance(enabled, bool):
        raise ValueError("browserWorkerEnabled in research configuration must be true or false")
    for key in ("browserWorkerMcpUrl", "browserWorkerTokenFile"):
        if key in config and (not isinstance(config[key], str) or not config[key].strip()):
            raise ValueError(f"{key} in research configuration must be a non-empty string")
    return config


def endpoint(config):
    raw = os.environ.get("BROWSER_WORKER_MCP_URL", config.get("browserWorkerMcpUrl", "http://127.0.0.1:8890/mcp"))
    # Deliberately canonical, matching the TS client: no parser normalization,
    # userinfo, localhost DNS, query, fragment, or implicit/default HTTP port.
    match = re.fullmatch(r"http://(127\.0\.0\.1|\[::1\]):([1-9][0-9]{0,4})/mcp", raw)
    if not match or not 1 <= int(match[2]) <= 65535 or int(match[2]) == 80:
        raise ValueError("BROWSER_WORKER_MCP_URL must be an uncredentialed loopback HTTP /mcp URL with an explicit non-default port")
    return raw


def token_file(config):
    return Path(os.environ.get("BROWSER_WORKER_MCP_TOKEN_FILE", config.get("browserWorkerTokenFile", str(
        Path.home() / "srv/browser-worker/shared/tokens/pi-production"
    ))))


def check(timeout=3.0, config=None):
    config = worker_config() if config is None else config
    raw = endpoint(config)
    url = urllib.parse.urlsplit(raw)
    token_path = token_file(config)
    try:
        token = read_bytes(token_path, 16384).decode("utf-8").strip()
    except (OSError, UnicodeError, RuntimeError):
        raise ValueError("browser-worker token file is missing, unreadable, or not UTF-8 (BROWSER_WORKER_MCP_TOKEN_FILE)") from None
    if not token:
        raise ValueError("browser-worker token file is empty")
    if not re.fullmatch(r"[\x21-\x7e]+", token):
        raise ValueError("browser-worker token file must contain a single printable ASCII token")
    request_id = "pi-check-" + str(uuid.uuid4())
    connection = http.client.HTTPConnection(url.hostname, url.port, timeout=timeout)
    try:
        connection.request("POST", "/mcp", body=json.dumps({
            "jsonrpc": "2.0", "id": request_id, "method": "tools/list", "params": {},
        }), headers={
            "Content-Type": "application/json", "Accept": "application/json",
            "Authorization": "Bearer " + token,
        })
        response = connection.getresponse()
        if response.status != 200:
            raise BrowserError("auth_failed" if response.status in (401, 403) else "http_error",
                               f"browser-worker tools/list returned HTTP {response.status} (check service/auth; redirects are refused)")
        body = response.read(1024 * 1024 + 1)
        if len(body) > 1024 * 1024:
            raise ValueError("browser-worker tools/list response exceeds 1 MiB")
        try:
            payload = json.loads(body)
        except (ValueError, UnicodeError):
            raise ValueError("browser-worker tools/list returned invalid JSON") from None
    except TimeoutError:
        raise BrowserError("timeout", "browser-worker tools/list unavailable or timed out; start/check the separately managed service") from None
    except (OSError, http.client.HTTPException):
        raise BrowserError("unavailable", "browser-worker tools/list unavailable or timed out; start/check the separately managed service") from None
    finally:
        connection.close()
    result = payload.get("result") if isinstance(payload, dict) else None
    tools = result.get("tools") if isinstance(result, dict) else None
    names = [t.get("name") for t in tools if isinstance(t, dict)] if isinstance(tools, list) else []
    if (not isinstance(payload, dict) or payload.get("jsonrpc") != "2.0" or
            payload.get("id") != request_id or "error" in payload or
            not isinstance(tools, list) or len(tools) != 2 or
            names.count("browser_fetch") != 1 or names.count("browser_inspect") != 1 or
            result.get("nextCursor") is not None):
        raise ValueError("MCP service is not the expected browser-worker (requires exactly browser_fetch and browser_inspect; websearch-shim is separate)")
    return raw


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--static", action="store_true", help="Inspect selection/endpoint/token-file presence only; no token read or network")
    parser.add_argument("--timeout", type=timeout_value, default=3.0)
    args = parser.parse_args()
    if args.json or args.static:
        row = capability("browser_worker", "static" if args.static else "authenticated_inventory", "not_checked", GUIDANCE,
                         execution="not_tested")
        try:
            config = worker_config()
            enabled = config.get("browserWorkerEnabled", True)
            row["selected"] = enabled
            if not enabled:
                row.update(outcome="disabled", configured="no")
            else:
                endpoint(config)  # Validate without emitting the URL or reading the token.
                row["token_file_present"] = token_file(config).is_file()
                row["configured"] = "yes" if row["token_file_present"] else "no"
                if args.static:
                    row["outcome"] = "not_checked" if row["token_file_present"] else "missing_token"
                else:
                    def expired(_signum, _frame):
                        raise BrowserError("timeout", "Browser inventory deadline exceeded")
                    signal.signal(signal.SIGALRM, expired)
                    signal.setitimer(signal.ITIMER_REAL, args.timeout)
                    try:
                        check(args.timeout, config)
                    finally:
                        signal.setitimer(signal.ITIMER_REAL, 0)
                    row.update(outcome="inventory_verified", inventory_verified=True)
        except (ValueError, OSError, RuntimeError) as error:
            row["outcome"] = getattr(error, "code", "invalid_config")
        row["verified_at"] = timestamp()
        print(json.dumps({"schema_version": 1, "capabilities": [row]}) if args.json else
              f"{row['outcome']}: {GUIDANCE}")
        return 0 if row["outcome"] in {"disabled", "not_checked", "inventory_verified"} else 2
    try:
        config = worker_config()
        if config.get("browserWorkerEnabled") is False:
            print("DISABLED: standalone browser-worker is not selected (browserWorkerEnabled=false); web_search/web_fetch and app_* are separate capabilities.")
            return 0
        url = check(args.timeout, config)
    except ValueError as error:
        print(f"WARN: optional browser-worker unavailable: {error}. {GUIDANCE}")
        return 2
    print(f"READY: optional browser-worker at {url}; authenticated tools/list verified browser_fetch and browser_inspect (browser execution not tested).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
