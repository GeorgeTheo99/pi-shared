#!/usr/bin/env bash
set -euo pipefail

# Repair the dedicated oMLX Pi profile so it uses shared Pi resources and so
# local OpenAI-compatible models that report zero token usage still get a sane
# estimated context percentage.

_self="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1 && readlink -f "$_self" >/dev/null 2>&1; then
  _self="$(readlink -f "$_self")"
else
  while [ -L "$_self" ]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    case "$_self" in
      /*) ;;
      *)  _self="$_dir/$_self" ;;
    esac
  done
fi
_DEFAULT_PI_SHARED_DIR="$(cd "$(dirname "$_self")/.." && pwd)"

PI_OMLX_AGENT_DIR="${PI_OMLX_AGENT_DIR:-$HOME/.pi-omlx/agent}"
PI_SHARED_DIR="${PI_SHARED_DIR:-$_DEFAULT_PI_SHARED_DIR}"
PI_LOCAL_EXTENSIONS_DIR="${PI_LOCAL_EXTENSIONS_DIR:-$HOME/local_code/pi-local/extensions}"
PI_INSTALL_DIR="${PI_INSTALL_DIR:-/opt/homebrew/lib/node_modules/@earendil-works/pi-coding-agent}"

mkdir -p "$PI_OMLX_AGENT_DIR"

python3 - "$PI_OMLX_AGENT_DIR/settings.json" "$PI_SHARED_DIR" "$PI_LOCAL_EXTENSIONS_DIR" <<'PY'
import json
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
settings_dir = path.parent
pi_shared_dir = Path(sys.argv[2]).expanduser().resolve()
local_extensions_arg = Path(sys.argv[3]).expanduser()
settings = {}
if path.exists():
    try:
        settings = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid JSON in {path}: {exc}")

def rel_from_settings(target: Path) -> str:
    try:
        return os.path.relpath(target.resolve(), settings_dir.resolve())
    except OSError:
        return str(target)

settings["packages"] = [rel_from_settings(pi_shared_dir)]
if local_extensions_arg.exists():
    settings["extensions"] = [rel_from_settings(local_extensions_arg.resolve())]
elif settings.get("extensions") == ["../../local_code/pi-local/extensions"]:
    settings.pop("extensions", None)
settings["skills"] = ["~/.codex/skills"]
settings["enableSkillCommands"] = True
# Default thinking on for every reasoning model in this profile. Local
# Qwen/GLM/Gemma/DeepSeek-V4 chat-template models only expose "high" in
# their thinkingLevelMap (the boolean enable_thinking toggle); cloud graded
# reasoning models also accept "high". Picking "high" is therefore valid
# for every model and keeps thinking on by default. Override per-session
# with /thinking off when needed.
settings.setdefault("defaultThinkingLevel", "high")

path.write_text(json.dumps(settings, indent=2) + "\n")
PY

ln -sfn "$PI_SHARED_DIR/AGENTS.md" "$PI_OMLX_AGENT_DIR/AGENTS.md"

COMPACTION_JS="$PI_INSTALL_DIR/dist/core/compaction/compaction.js"
if [[ -f "$COMPACTION_JS" ]]; then
  if ! python3 - "$COMPACTION_JS" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()
# Pi >= 0.80.0 upstreamed the zero-usage guard directly into getAssistantUsage.
# If the guard is already present (upstream or from a prior run), nothing to do.
if "calculateContextTokens(assistantMsg.usage) > 0" in text:
    raise SystemExit(0)
old = '''function getAssistantUsage(msg) {
    if (msg.role === "assistant" && "usage" in msg) {
        const assistantMsg = msg;
        if (assistantMsg.stopReason !== "aborted" && assistantMsg.stopReason !== "error" && assistantMsg.usage) {
            return assistantMsg.usage;
        }
    }
    return undefined;
}
'''
new = '''function getAssistantUsage(msg) {
    if (msg.role === "assistant" && "usage" in msg) {
        const assistantMsg = msg;
        if (assistantMsg.stopReason !== "aborted" && assistantMsg.stopReason !== "error" && assistantMsg.usage) {
            const contextTokens = calculateContextTokens(assistantMsg.usage);
            if (contextTokens > 0) {
                return assistantMsg.usage;
            }
        }
    }
    return undefined;
}
'''
if new in text:
    raise SystemExit(0)
if old not in text:
    raise SystemExit(f"Expected getAssistantUsage block not found in {path}; Pi version may have changed")
backup = path.with_suffix(path.suffix + ".pre-zero-usage-fallback.bak")
if not backup.exists():
    backup.write_text(text)
path.write_text(text.replace(old, new))
PY
  then
    echo "warning: compaction zero-usage patch did not apply (Pi version may have changed); skipping" >&2
  fi
else
  echo "warning: Pi compaction file not found: $COMPACTION_JS" >&2
fi

# pi-ai 0.80.0+ restructured dist: providers moved from dist/providers/ to
# dist/api/. Resolve across both layouts so the DSML filter patch survives updates.
OPENAI_COMPLETIONS_JS=""
for candidate in \
  "$PI_INSTALL_DIR/node_modules/@earendil-works/pi-ai/dist/api/openai-completions.js" \
  "$PI_INSTALL_DIR/node_modules/@earendil-works/pi-ai/dist/providers/openai-completions.js"; do
  if [[ -f "$candidate" ]]; then
    OPENAI_COMPLETIONS_JS="$candidate"
    break
  fi
done
if [[ -n "$OPENAI_COMPLETIONS_JS" ]]; then
  if ! python3 - "$OPENAI_COMPLETIONS_JS" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()
original = text

old1 = '''function hasToolHistory(messages) {
    for (const msg of messages) {
        if (msg.role === "toolResult") {
            return true;
        }
        if (msg.role === "assistant") {
            if (msg.content.some((block) => block.type === "toolCall")) {
                return true;
            }
        }
    }
    return false;
}
function isTextContentBlock(block) {
'''
new1 = '''function hasToolHistory(messages) {
    for (const msg of messages) {
        if (msg.role === "toolResult") {
            return true;
        }
        if (msg.role === "assistant") {
            if (msg.content.some((block) => block.type === "toolCall")) {
                return true;
            }
        }
    }
    return false;
}
function createDsmlToolMarkupFilter(enabled) {
    let pending = "";
    let suppressing = false;
    const markers = ["<｜DSML｜", "</｜DSML｜"];
    const keepChars = 16;
    const findMarker = (text) => {
        let index = -1;
        for (const marker of markers) {
            const found = text.indexOf(marker);
            if (found !== -1 && (index === -1 || found < index)) {
                index = found;
            }
        }
        return index;
    };
    return {
        filter(delta) {
            if (!enabled || !delta) {
                return delta || "";
            }
            if (suppressing) {
                return "";
            }
            const combined = pending + delta;
            const markerIndex = findMarker(combined);
            if (markerIndex !== -1) {
                suppressing = true;
                pending = "";
                return combined.slice(0, markerIndex);
            }
            if (combined.length <= keepChars) {
                pending = combined;
                return "";
            }
            pending = combined.slice(-keepChars);
            return combined.slice(0, -keepChars);
        },
        flush() {
            if (!enabled || suppressing) {
                pending = "";
                return "";
            }
            const text = pending;
            pending = "";
            return text;
        },
    };
}
function isTextContentBlock(block) {
'''
if "function createDsmlToolMarkupFilter" not in text:
    if old1 not in text:
        raise SystemExit(f"Expected hasToolHistory insertion point not found in {path}")
    text = text.replace(old1, new1, 1)

old2 = '''            const ensureTextBlock = () => {
                if (!textBlock) {
                    textBlock = { type: "text", text: "" };
                    blocks.push(textBlock);
                    stream.push({ type: "text_start", contentIndex: getContentIndex(textBlock), partial: output });
                }
                return textBlock;
            };
'''
new2 = '''            const ensureTextBlock = () => {
                if (!textBlock) {
                    textBlock = { type: "text", text: "" };
                    blocks.push(textBlock);
                    stream.push({ type: "text_start", contentIndex: getContentIndex(textBlock), partial: output });
                }
                return textBlock;
            };
            const dsmlTextFilter = createDsmlToolMarkupFilter(!!compat.stripDsmlToolMarkup);
'''
if "const dsmlTextFilter = createDsmlToolMarkupFilter" not in text:
    if old2 not in text:
        raise SystemExit(f"Expected ensureTextBlock block not found in {path}")
    text = text.replace(old2, new2, 1)

old3 = '''                    if (choice.delta.content !== null &&
                        choice.delta.content !== undefined &&
                        choice.delta.content.length > 0) {
                        const block = ensureTextBlock();
                        block.text += choice.delta.content;
                        stream.push({
                            type: "text_delta",
                            contentIndex: getContentIndex(block),
                            delta: choice.delta.content,
                            partial: output,
                        });
                    }
'''
new3 = '''                    let contentDelta = choice.delta.content;
                    if (contentDelta !== null &&
                        contentDelta !== undefined &&
                        contentDelta.length > 0) {
                        contentDelta = dsmlTextFilter.filter(contentDelta);
                        if (contentDelta.length > 0) {
                            const block = ensureTextBlock();
                            block.text += contentDelta;
                            stream.push({
                                type: "text_delta",
                                contentIndex: getContentIndex(block),
                                delta: contentDelta,
                                partial: output,
                            });
                        }
                    }
'''
if "let contentDelta = choice.delta.content;" not in text:
    if old3 not in text:
        raise SystemExit(f"Expected content delta block not found in {path}")
    text = text.replace(old3, new3, 1)

old4 = '''            for (const block of blocks) {
                finishBlock(block);
            }
            if (options?.signal?.aborted) {
'''
new4 = '''            {
                const flushDelta = dsmlTextFilter.flush();
                if (flushDelta) {
                    const block = ensureTextBlock();
                    block.text += flushDelta;
                    stream.push({
                        type: "text_delta",
                        contentIndex: getContentIndex(block),
                        delta: flushDelta,
                        partial: output,
                    });
                }
            }
            for (const block of blocks) {
                finishBlock(block);
            }
            if (options?.signal?.aborted) {
'''
if "const flushDelta = dsmlTextFilter.flush();" not in text:
    if old4 not in text:
        raise SystemExit(f"Expected final finalize loop not found in {path}")
    text = text.replace(old4, new4, 1)

old5 = '''        sendSessionAffinityHeaders: model.compat.sendSessionAffinityHeaders ?? detected.sendSessionAffinityHeaders,
        supportsLongCacheRetention: model.compat.supportsLongCacheRetention ?? detected.supportsLongCacheRetention,
    };
'''
new5 = '''        sendSessionAffinityHeaders: model.compat.sendSessionAffinityHeaders ?? detected.sendSessionAffinityHeaders,
        supportsLongCacheRetention: model.compat.supportsLongCacheRetention ?? detected.supportsLongCacheRetention,
        stripDsmlToolMarkup: model.compat.stripDsmlToolMarkup ?? false,
    };
'''
if "stripDsmlToolMarkup: model.compat.stripDsmlToolMarkup" not in text:
    if old5 not in text:
        raise SystemExit(f"Expected getCompat tail block not found in {path}")
    text = text.replace(old5, new5, 1)

if text != original:
    backup = path.with_suffix(path.suffix + ".pre-dsml-filter.bak")
    if not backup.exists():
        backup.write_text(original)
    path.write_text(text)
PY
  then
    echo "warning: openai-completions DSML filter patch did not apply (Pi version may have changed); skipping" >&2
  fi
else
  echo "warning: Pi OpenAI completions provider not found in dist/api/ or dist/providers/; skipping DSML filter patch" >&2
fi

# GLM-5.2 support now ships upstream in oMLX as the `omlx.patches.glm_moe_dsa`
# framework (with optional bundled native kernels). Do not re-copy the retired
# pi-shared `patches/glm_5_2` monkey patch here; uv-tool reinstalls should use
# upstream oMLX's model-loading dispatch unchanged.

printf 'Repaired oMLX Pi profile at %s\n' "$PI_OMLX_AGENT_DIR"
