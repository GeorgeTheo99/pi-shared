#!/usr/bin/env bash
set -euo pipefail

# Repair the dedicated oMLX/cloud Pi profile's shared-resource wiring only.
# Pi and provider runtime code remain owned by their package manager. Do not
# patch global npm packages, Homebrew kegs, SDK files, or bundled CLI chunks.

_self="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1 && readlink -f "$_self" >/dev/null 2>&1; then
  _self="$(readlink -f "$_self")"
else
  while [ -L "$_self" ]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    case "$_self" in
      /*) ;;
      *)  _self="$_dir/$_self" ;;
    esac
  done
fi
_DEFAULT_PI_SHARED_DIR="$(cd "$(dirname "$_self")/.." && pwd)"

PI_OMLX_AGENT_DIR="${PI_OMLX_AGENT_DIR:-$HOME/.pi-omlx/agent}"
PI_SHARED_DIR="${PI_SHARED_DIR:-$_DEFAULT_PI_SHARED_DIR}"
PI_DATABRICKS_DIR="${PI_DATABRICKS_DIR:-$(dirname "$PI_SHARED_DIR")/pi-databricks}"

mkdir -p "$PI_OMLX_AGENT_DIR"

python3 - "$PI_OMLX_AGENT_DIR/settings.json" "$PI_SHARED_DIR" "$PI_DATABRICKS_DIR" <<'PY'
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

path = Path(sys.argv[1])
settings_dir = path.parent
pi_shared_dir = Path(sys.argv[2]).expanduser().resolve()
pi_databricks_arg = Path(sys.argv[3]).expanduser()
settings = {}
original = None
if path.exists():
    original = path.read_text()
    try:
        settings = json.loads(original)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid JSON in {path}: {exc}")

# pi-databricks is loaded as a full package (extensions + skills + skills-das),
# so no separate top-level resource entries are needed.
packages = settings.get("packages")
if packages is None:
    packages = []
if not isinstance(packages, list):
    raise SystemExit(f"Expected packages array in {path}")

def package_path(entry):
    source = (entry.get("source") or entry.get("path")) if isinstance(entry, dict) else entry
    if not isinstance(source, str) or source.startswith(("npm:", "git:", "https:", "ssh:")):
        return None
    return (settings_dir / Path(source).expanduser()).resolve()

for required in [pi_shared_dir, *([pi_databricks_arg.resolve()] if pi_databricks_arg.exists() else [])]:
    if required not in [package_path(entry) for entry in packages]:
        # Absolute, as the installer writes it: hosts that copy settings.json into
        # a per-session agent directory would not resolve a relative source.
        packages.append(str(required))
settings["packages"] = packages
if settings.get("extensions") == ["../../local_code/pi-databricks/extensions"]:
    settings.pop("extensions", None)
if settings.get("skills") == ["~/.codex/skills"]:
    settings.pop("skills", None)
# Defaults for a fresh or reset profile. This also runs on every gateway launch
# of the default profile, so an explicit choice is never overridden.
settings.setdefault("enableSkillCommands", True)
# Pi clamps this preference to each model's supported levels. Explicit choices
# remain untouched; override per-session with /thinking when supported.
settings.setdefault("defaultThinkingLevel", "high")
# Pi 1.0 defaults to fullscreen, which pins widgets and dialogs below a
# scrolling transcript. Keep normal scrollback unless a mode was chosen.
settings.setdefault("tuiMode", "regular")
default_tools = settings.get("defaultTools", [])
if not isinstance(default_tools, list):
    raise SystemExit(f"Expected defaultTools array in {path}")
if not any(choice in default_tools for choice in ("codemode", "+codemode", "-codemode")):
    # Probe only a version; never load extensions or modify a packaged runtime.
    executable = os.environ.get("PI_UPSTREAM_BIN") or shutil.which("pi")
    try:
        result = subprocess.run([executable, "--version"], capture_output=True, text=True, timeout=5) if executable else None
        version = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", result.stdout.strip()) if result and result.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        version = None
    if version and tuple(map(int, version.groups()[:2])) >= (0, 99):
        settings["defaultTools"] = [*default_tools, "+codemode"]

# Every launch runs this, possibly concurrently with other launches and with a
# running Pi saving its settings: write only a real change, and atomically.
rendered = json.dumps(settings, indent=2) + "\n"
if rendered != original:
    target = path.resolve()
    mode = target.stat().st_mode & 0o777 if target.exists() else 0o600
    tmp = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=target.parent, prefix=".settings-", suffix=".tmp", delete=False) as stream:
            tmp = Path(stream.name)
            os.fchmod(stream.fileno(), mode)
            stream.write(rendered)
        tmp.replace(target)
    finally:
        if tmp is not None:
            tmp.unlink(missing_ok=True)
PY

# Like the installer, never replace instructions the owner wrote themselves.
agents_md="$PI_OMLX_AGENT_DIR/AGENTS.md"
if [ ! -e "$agents_md" ] || [ -L "$agents_md" ]; then
  ln -sfn "$PI_SHARED_DIR/AGENTS.md" "$agents_md"
fi
printf 'Repaired oMLX Pi profile at %s (runtime unchanged)\n' "$PI_OMLX_AGENT_DIR"
