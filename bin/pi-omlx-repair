#!/usr/bin/env bash
set -euo pipefail

# Repair the dedicated oMLX/cloud Pi profile's shared-resource wiring only.
# Pi and provider runtime code remain owned by their package manager. Do not
# patch global npm packages, Homebrew kegs, SDK files, or bundled CLI chunks.

_self="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1 && readlink -f "$_self" >/dev/null 2>&1; then
  _self="$(readlink -f "$_self")"
else
  while [ -L "$_self" ]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    case "$_self" in
      /*) ;;
      *)  _self="$_dir/$_self" ;;
    esac
  done
fi
_DEFAULT_PI_SHARED_DIR="$(cd "$(dirname "$_self")/.." && pwd)"

PI_OMLX_AGENT_DIR="${PI_OMLX_AGENT_DIR:-$HOME/.pi-omlx/agent}"
PI_SHARED_DIR="${PI_SHARED_DIR:-$_DEFAULT_PI_SHARED_DIR}"
PI_DATABRICKS_DIR="${PI_DATABRICKS_DIR:-$(dirname "$PI_SHARED_DIR")/pi-databricks}"

mkdir -p "$PI_OMLX_AGENT_DIR"

python3 - "$PI_OMLX_AGENT_DIR/settings.json" "$PI_SHARED_DIR" "$PI_DATABRICKS_DIR" <<'PY'
import json
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
settings_dir = path.parent
pi_shared_dir = Path(sys.argv[2]).expanduser().resolve()
pi_databricks_arg = Path(sys.argv[3]).expanduser()
settings = {}
if path.exists():
    try:
        settings = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid JSON in {path}: {exc}")

def rel_from_settings(target: Path) -> str:
    try:
        return os.path.relpath(target.resolve(), settings_dir.resolve())
    except OSError:
        return str(target)

# pi-databricks is loaded as a full package (extensions + skills + skills-das),
# so no separate top-level resource entries are needed.
packages = settings.get("packages", [])
if not isinstance(packages, list):
    raise SystemExit(f"Expected packages array in {path}")

def package_path(entry):
    source = (entry.get("source") or entry.get("path")) if isinstance(entry, dict) else entry
    if not isinstance(source, str) or source.startswith(("npm:", "git:", "https:", "ssh:")):
        return None
    return (settings_dir / Path(source).expanduser()).resolve()

for required in [pi_shared_dir, *([pi_databricks_arg.resolve()] if pi_databricks_arg.exists() else [])]:
    if required not in [package_path(entry) for entry in packages]:
        packages.append(rel_from_settings(required))
settings["packages"] = packages
if settings.get("extensions") == ["../../local_code/pi-databricks/extensions"]:
    settings.pop("extensions", None)
if settings.get("skills") == ["~/.codex/skills"]:
    settings.pop("skills", None)
settings["enableSkillCommands"] = True
# Pi clamps this preference to each model's supported levels. Explicit choices
# remain untouched; override per-session with /thinking when supported.
settings.setdefault("defaultThinkingLevel", "high")

path.write_text(json.dumps(settings, indent=2) + "\n")
PY

ln -sfn "$PI_SHARED_DIR/AGENTS.md" "$PI_OMLX_AGENT_DIR/AGENTS.md"
printf 'Repaired oMLX Pi profile at %s (runtime unchanged)\n' "$PI_OMLX_AGENT_DIR"
