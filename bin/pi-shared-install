#!/usr/bin/env bash
# pi-shared-install — portable installer for shared Pi resources.
#
# Installs helper launchers into ~/.local/bin, wires this repo into
# ~/.pi/agent/settings.json as a package, optionally renders initial Pi catalog
# artifacts when a model-aliases.json file is present, and prints the shell line
# to source generated launchers.
#
# Usage:
#   pi-shared-install [--force] [--no-catalog] [--no-deps] [--aliases PATH]
#                     [--models-out PATH] [--launchers-out PATH]
#                     [--pi-agent-dir PATH|''] [--provider-name NAME]
#                     [--ls99-extras] [--overlay PACKAGE_DIR ...]
#
# Extension runtime dependencies: every directory under extensions/ that has
# both package.json and package-lock.json with non-empty dependencies gets a
# locked `npm ci --ignore-scripts`. Pi imports extension sources at startup, so
# a missing dependency breaks every session; the installer therefore FAILS if
# npm is missing or npm ci fails. Browser binaries are never downloaded here.
#
# --pi-agent-dir '' (empty) renders launchers for Pi's DEFAULT profile
# (no PI_CODING_AGENT_DIR override) — use this on machines whose models.json
# lives in ~/.pi/agent (e.g. gateway-only setups without an oMLX profile).
set -euo pipefail

_self="${BASH_SOURCE[0]:-$0}"
if command -v readlink >/dev/null 2>&1 && readlink -f "$_self" >/dev/null 2>&1; then
  _self="$(readlink -f "$_self")"
else
  while [ -L "$_self" ]; do
    _dir="$(cd "$(dirname "$_self")" && pwd)"
    _self="$(readlink "$_self")"
    case "$_self" in
      /*) ;;
      *)  _self="$_dir/$_self" ;;
    esac
  done
fi
ROOT_DIR="$(cd "$(dirname "$_self")/.." && pwd)"

BIN_DIR="${PI_SHARED_BIN_DIR:-$HOME/.local/bin}"
PI_AGENT_DIR="${PI_SHARED_AGENT_DIR:-$HOME/.pi/agent}"
PI_OMLX_AGENT_DIR="${PI_SHARED_OMLX_AGENT_DIR:-$HOME/.pi-omlx/agent}"
ALIASES_PATH="${PI_SHARED_ALIASES:-$HOME/.pi/model-aliases.json}"
MODELS_OUT="${PI_SHARED_MODELS_OUT:-$PI_OMLX_AGENT_DIR/models.json}"
LAUNCHERS_OUT="${PI_SHARED_LAUNCHERS_OUT:-$HOME/.pi/generated/pi-launchers.zsh}"
# Launcher Pi profile: default = the oMLX profile; empty = Pi default profile.
CATALOG_PI_AGENT_DIR="${PI_SHARED_CATALOG_PI_AGENT_DIR-$PI_OMLX_AGENT_DIR}"
PROVIDER_NAME="${PI_SHARED_PROVIDER_NAME:-}"
FORCE=0
GENERATE_CATALOG=1
INSTALL_DEPS=1
NPM_BIN="${PI_SHARED_NPM:-npm}"
LS99_EXTRAS="${PI_SHARED_LS99_EXTRAS:-0}"
declare -a OVERLAY_DIRS=()

if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
  C_RESET=""; C_BOLD=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi

log()  { printf '%s▶%s %s\n' "$C_BOLD" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

usage() {
  sed -n '2,/^set -euo/p' "$0" | grep -E '^#   ' | sed 's/^#   /  /'
  exit 1
}

expand_path() {
  local p="$1"
  case "$p" in
    ~) printf '%s\n' "$HOME" ;;
    ~/*) printf '%s/%s\n' "$HOME" "${p#~/}" ;;
    *) printf '%s\n' "$p" ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --no-catalog) GENERATE_CATALOG=0 ;;
    --no-deps) INSTALL_DEPS=0 ;;
    --aliases) shift; [ $# -gt 0 ] || die "--aliases requires a path"; ALIASES_PATH="$(expand_path "$1")" ;;
    --models-out) shift; [ $# -gt 0 ] || die "--models-out requires a path"; MODELS_OUT="$(expand_path "$1")" ;;
    --launchers-out) shift; [ $# -gt 0 ] || die "--launchers-out requires a path"; LAUNCHERS_OUT="$(expand_path "$1")" ;;
    --pi-agent-dir) shift; [ $# -gt 0 ] || die "--pi-agent-dir requires a path (or '' for the default Pi profile)"; CATALOG_PI_AGENT_DIR="$([ -n "$1" ] && expand_path "$1" || true)" ;;
    --provider-name) shift; [ $# -gt 0 ] || die "--provider-name requires a name"; PROVIDER_NAME="$1" ;;
    --ls99-extras) LS99_EXTRAS=1 ;;
    --overlay) shift; [ $# -gt 0 ] || die "--overlay requires a package directory"; OVERLAY_DIRS+=("$(expand_path "$1")") ;;
    -h|--help|help) usage ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

MODELS_OUT="$(expand_path "$MODELS_OUT")"
LAUNCHERS_OUT="$(expand_path "$LAUNCHERS_OUT")"
PI_AGENT_DIR="$(expand_path "$PI_AGENT_DIR")"
PI_OMLX_AGENT_DIR="$(expand_path "$PI_OMLX_AGENT_DIR")"
ALIASES_PATH="$(expand_path "$ALIASES_PATH")"
[ -n "$CATALOG_PI_AGENT_DIR" ] && CATALOG_PI_AGENT_DIR="$(expand_path "$CATALOG_PI_AGENT_DIR")"

install_symlink() {
  local name="$1"
  local src="$ROOT_DIR/bin/$name"
  local dest="$BIN_DIR/$name"
  [ -f "$src" ] || die "missing $src"
  mkdir -p "$BIN_DIR"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    if [ "$FORCE" -eq 1 ]; then
      rm -f "$dest"
    else
      warn "$dest exists and is not a symlink; leaving it untouched (use --force to replace)"
      return 0
    fi
  fi
  ln -sfn "$src" "$dest"
  ok "Installed $dest → $src"
}

# Extension directories that need a locked dependency install (have
# package.json + package-lock.json and at least one runtime dependency).
locked_extension_dirs() {
  python3 - "$ROOT_DIR/extensions" <<'PY'
import json, sys
from pathlib import Path
root = Path(sys.argv[1])
for pkg in sorted(root.glob("*/package.json")):
    d = pkg.parent
    if not (d / "package-lock.json").is_file():
        continue
    try:
        deps = json.loads(pkg.read_text()).get("dependencies") or {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid JSON in {pkg}: {exc}")
    if deps:
        print(d)
PY
}

install_extension_deps() {
  if [ "$INSTALL_DEPS" -eq 0 ]; then
    warn "Skipping extension dependency install (--no-deps)"
    return 0
  fi
  local dirs
  dirs="$(locked_extension_dirs)"
  [ -n "$dirs" ] || return 0
  command -v "$NPM_BIN" >/dev/null 2>&1 \
    || die "npm is required to install extension dependencies ($(printf '%s' "$dirs" | tr '\n' ' ')). Install Node.js (e.g. brew install node) and re-run."
  local d
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    log "Installing locked dependencies in ${d#"$ROOT_DIR"/}"
    (cd "$d" && "$NPM_BIN" ci --ignore-scripts --no-audit --no-fund --loglevel=error) \
      || die "npm ci failed in $d (registry: $("$NPM_BIN" config get registry 2>/dev/null || echo unknown)). If the registry returned 5xx, retry in a minute or point ~/.npmrc at a reachable mirror; then re-run: (cd $d && npm ci --ignore-scripts)"
  done <<< "$dirs"
  "$ROOT_DIR/bin/pi-shared-check-deps" >/dev/null \
    || die "extension dependencies still do not resolve after npm ci; run $ROOT_DIR/bin/pi-shared-check-deps for details"
  ok "Extension dependencies installed and resolvable"
}

wire_settings() {
  local target="${1:-$PI_AGENT_DIR}" repo="${2:-$ROOT_DIR}"
  [ -f "$repo/package.json" ] || die "Pi package is missing: $repo/package.json"
  mkdir -p "$target"
  python3 - "$target/settings.json" "$repo" <<'PY'
import json
import os
import sys
from pathlib import Path

settings_path = Path(sys.argv[1]).expanduser()
settings_dir = settings_path.parent
repo = Path(sys.argv[2]).expanduser().resolve()
settings = {}
if settings_path.exists():
    try:
        settings = json.loads(settings_path.read_text())
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid JSON in {settings_path}: {exc}")
packages = settings.get("packages", [])
if packages is None:
    packages = []
if not isinstance(packages, list):
    raise SystemExit(f"Expected {settings_path} packages to be an array")

def package_source(entry):
    if isinstance(entry, str):
        return entry
    if isinstance(entry, dict):
        source = entry.get("source") or entry.get("path")
        return source if isinstance(source, str) else None
    return None

def resolve_source(source: str) -> Path:
    return (settings_dir / Path(source).expanduser()).resolve()

seen_repo = False
new_packages = []
seen_resolved = set()
for entry in packages:
    source = package_source(entry)
    if source:
        try:
            resolved = resolve_source(source)
        except OSError:
            resolved = None
        if resolved == repo:
            if seen_repo:
                continue
            seen_repo = True
        key = str(resolved) if resolved else json.dumps(entry, sort_keys=True)
        if key in seen_resolved:
            continue
        seen_resolved.add(key)
    new_packages.append(entry)

if not seen_repo:
    rel = os.path.relpath(repo, settings_dir.resolve())
    new_packages.append(rel)
settings["packages"] = new_packages
settings_path.parent.mkdir(parents=True, exist_ok=True)
tmp = settings_path.with_suffix(settings_path.suffix + ".tmp")
tmp.write_text(json.dumps(settings, indent=2) + "\n")
tmp.replace(settings_path)
print(settings_path)
PY
  ok "Wired $repo into $target/settings.json packages"
}

wire_agents_md() {
  local target="${1:-$PI_AGENT_DIR}"
  local dest="$target/AGENTS.md" src="$ROOT_DIR/AGENTS.md"
  [ -f "$src" ] || return 0
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    if [ "$FORCE" -eq 1 ]; then
      rm -f "$dest"
    else
      warn "$dest exists and is not a symlink; leaving it untouched (use --force to replace)"
      return 0
    fi
  fi
  ln -sfn "$src" "$dest"
  ok "Installed $dest → $src"
}

generate_catalog() {
  if [ "$GENERATE_CATALOG" -eq 0 ]; then
    warn "Skipping pi-catalog generation (--no-catalog)"
    return 0
  fi
  if [ ! -f "$ALIASES_PATH" ]; then
    warn "No alias catalog at $ALIASES_PATH; configure its producer or pass --aliases PATH. Skipping initial pi-catalog generation."
    return 0
  fi
  mkdir -p "$(dirname "$MODELS_OUT")" "$(dirname "$LAUNCHERS_OUT")"
  local cmd=("$ROOT_DIR/bin/pi-catalog" --aliases "$ALIASES_PATH" --models-out "$MODELS_OUT" --launchers-out "$LAUNCHERS_OUT")
  if [ -n "$CATALOG_PI_AGENT_DIR" ]; then
    cmd+=(--pi-agent-dir "$CATALOG_PI_AGENT_DIR")
  fi
  if [ -n "$PROVIDER_NAME" ]; then
    cmd+=(--provider-name "$PROVIDER_NAME")
  fi
  if [ "$LS99_EXTRAS" = "1" ]; then
    cmd+=(--ls99-extras)
  fi
  log "Rendering Pi catalog artifacts"
  "${cmd[@]}"
  ok "Rendered $MODELS_OUT and $LAUNCHERS_OUT"
}

migrate_legacy_launcher_path() {
  local canonical="$HOME/.pi/generated/pi-launchers.zsh"
  local legacy="$HOME/.pi/model-gateway/pi-launchers.zsh"
  [ "$LAUNCHERS_OUT" = "$canonical" ] || return 0
  [ -f "$canonical" ] || return 0
  [ -e "$legacy" ] || [ -L "$legacy" ] || return 0

  if [ ! -L "$legacy" ] && ! head -n 1 "$legacy" 2>/dev/null | grep -q '^# Generated by pi-shared/bin/pi-catalog'; then
    warn "Legacy launcher $legacy is not recognized as generated; leaving it untouched"
    return 0
  fi

  rm -f "$legacy"
  ln -s "$canonical" "$legacy"
  warn "Compatibility link installed at $legacy; update your shell to source $canonical"
}

main() {
  [ "$(uname -s)" = "Darwin" ] || warn "pi-shared installer is intended for macOS; continuing because no launchd changes are required"
  log "Installing pi-shared from $ROOT_DIR"
  install_symlink pi-catalog
  install_symlink pi-omlx-repair
  install_symlink pi-vanilla
  install_extension_deps
  wire_settings
  local overlay
  for overlay in "${OVERLAY_DIRS[@]:-}"; do
    [ -z "$overlay" ] || wire_settings "$PI_AGENT_DIR" "$overlay"
  done
  wire_agents_md
  generate_catalog
  # Wire the actual model profile now, without depending on ~/.local/bin being
  # in a future shell's PATH or executing the runtime-patching repair script.
  if [ "$GENERATE_CATALOG" -eq 1 ] && [ -s "$MODELS_OUT" ] && [ -n "$CATALOG_PI_AGENT_DIR" ]; then
    wire_settings "$CATALOG_PI_AGENT_DIR"
    for overlay in "${OVERLAY_DIRS[@]:-}"; do
      [ -z "$overlay" ] || wire_settings "$CATALOG_PI_AGENT_DIR" "$overlay"
    done
    wire_agents_md "$CATALOG_PI_AGENT_DIR"
  fi
  migrate_legacy_launcher_path
  if [ -s "$LAUNCHERS_OUT" ] && ! grep -qsF 'pi-launchers.zsh' "$HOME/.zshrc"; then
    printf '\nNext step: source the generated launchers so pi-list is available (pi-setup/install.sh does this for you):\n'
    printf '  [ -f %q ] && source %q\n' "$LAUNCHERS_OUT" "$LAUNCHERS_OUT"
  fi
  ok "pi-shared installed"
}

main
