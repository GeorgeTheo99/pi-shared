#!/usr/bin/env python3
"""Refresh generated launcher data without evaluating shell input or probing services."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
HEADER = "# Generated by pi-shared/bin/pi-catalog — do not hand-edit.\n"
PREFIX = "# pi-catalog-args: "
VALUES = {"--aliases", "--models-out", "--launchers-out", "--provider-name", "--gateway-url",
          "--gateway-api-key", "--pi-agent-dir", "--omlx-status", "--omlx-status-url", "--shared-dir"}
FLAGS = {"--direct-launchers", "--no-direct-launchers", "--allow-empty-catalog"}


class EditedModels(ValueError):
    pass


def read_owned(path, limit, missing=False):
    if missing and not path.exists() and not path.is_symlink():
        return b""
    target = path.resolve(strict=True)
    info = target.stat()
    parent = target.parent.stat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022
            or info.st_nlink != 1 or parent.st_uid != os.getuid() or parent.st_mode & 0o022
            or info.st_size > limit):
        raise ValueError("Unsafe or oversized launcher/catalog file")
    with target.open("rb") as stream:
        raw = stream.read(limit + 1)
    if len(raw) > limit:
        raise ValueError("File size limit exceeded")
    return raw


def arguments(raw, launcher):
    text = raw.decode("utf-8")
    rows = [line[len(PREFIX):] for line in text.splitlines() if line.startswith(PREFIX)]
    if not text.startswith(HEADER) or len(rows) != 1:
        raise ValueError("Launcher lacks safe regeneration metadata; rerun setup")
    args = json.loads(rows[0])
    if not isinstance(args, list) or len(args) > 48 or any(not isinstance(a, str) or len(a) > 8192 for a in args):
        raise ValueError("Invalid regeneration metadata")
    values = {}
    index = 0
    seen = set()
    while index < len(args):
        flag = args[index]
        if flag in seen or flag not in VALUES | FLAGS:
            raise ValueError("Unsupported regeneration option")
        seen.add(flag)
        index += 1
        if flag in VALUES:
            if index == len(args):
                raise ValueError("Missing option value")
            values[flag] = args[index]
            index += 1
    for flag in ("--aliases", "--models-out", "--launchers-out", "--pi-agent-dir", "--omlx-status", "--shared-dir"):
        if flag in values and (not values[flag] or not Path(values[flag]).is_absolute()):
            raise ValueError("Regeneration paths must be absolute")
    if not values.get("--shared-dir") or not values.get("--launchers-out"):
        raise ValueError("Missing generation identity")
    if Path(values["--launchers-out"]).resolve() != launcher.resolve():
        raise ValueError("Launcher output identity mismatch")
    if Path(values.get("--shared-dir", "")).resolve() != ROOT:
        raise ValueError("Launcher belongs to a different shared installation")
    if not values.get("--aliases"):
        raise ValueError("Missing alias input")
    roles = [Path(values[key]).resolve() for key in ("--aliases", "--omlx-status", "--models-out", "--launchers-out") if values.get(key)]
    if len(set(roles)) != len(roles):
        raise ValueError("Input/output paths must not overlap")
    if values.get("--models-out"):
        target = Path(values["--models-out"]).resolve()
        if target.exists():
            read_owned(target, 8 * 1024 * 1024)
        parent = target.parent
        while not parent.exists():
            parent = parent.parent
        info = parent.stat()
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ValueError("Unsafe models output directory")
    status_rows = [line[len("# pi-catalog-status: "):] for line in text.splitlines() if line.startswith("# pi-catalog-status: ")]
    if len(status_rows) > 1:
        raise ValueError("Duplicate cached status metadata")
    cache = json.loads(status_rows[0]) if status_rows else {}
    if (not isinstance(cache, dict) or any(not isinstance(k, str) or not isinstance(v, dict)
            or set(v) - {"max_context_window", "max_tokens", "thinking_default"}
            or any(not isinstance(x, (bool, int, str)) for x in v.values()) for k, v in cache.items())):
        raise ValueError("Invalid cached status metadata")
    model_rows = [line[len("# pi-catalog-models-sha256: "):] for line in text.splitlines() if line.startswith("# pi-catalog-models-sha256: ")]
    if len(model_rows) > 1:
        raise ValueError("Duplicate models ownership metadata")
    expected = model_rows[0] if model_rows else "unmanaged"
    if expected != "unmanaged" and (len(expected) != 64 or any(c not in "0123456789abcdef" for c in expected)):
        raise ValueError("Invalid models ownership metadata")
    return (args, [Path(values[key]) for key in ("--aliases", "--omlx-status") if values.get(key)], cache,
            Path(values["--models-out"]) if values.get("--models-out") else None, expected)


def refresh(launcher, poll=None):
    stamp = hashlib.sha256(str(launcher).encode()).hexdigest()
    try:
        # Even failures are memoized by file identity/content so a broken input
        # warns once, then retries only when it changes. No shell text is eval'd.
        info = launcher.lstat()
        stamp = hashlib.sha256(repr((str(launcher), info.st_ino, info.st_mtime_ns, info.st_size, info.st_mode)).encode()).hexdigest()
        raw = read_owned(launcher, 2 * 1024 * 1024)
        stamp = hashlib.sha256(raw).hexdigest()
        args, inputs, cache, models, expected = arguments(raw, launcher)
        contents = [read_owned(p, 8 * 1024 * 1024, missing=True) for p in inputs]
        model_raw = read_owned(models, 8 * 1024 * 1024, missing=True) if models else b""
        stamp = hashlib.sha256(raw + b"\0" + b"\0".join(contents) + b"\0" + model_raw).hexdigest()
        if poll == stamp:
            return 0
        if models and models.exists():
            writes_models = bool(json.loads(contents[0])) if contents[0] else False
            if ((expected == "unmanaged" and writes_models)
                    or (expected != "unmanaged" and hashlib.sha256(model_raw).hexdigest() != expected)):
                raise EditedModels("Generated models were edited or are not managed. Automatic refresh paused; inspect model configuration before using pi-regen.")
        with tempfile.TemporaryDirectory(prefix="pi-launcher-status-") as directory:
            status_file = Path(directory) / "status.json"
            status_file.write_text(json.dumps({"models": [{"id": k, **v} for k, v in cache.items()]}))
            result = subprocess.run([str(ROOT / "bin/pi-catalog"), "--args-stdin"],
                                    input=json.dumps([*args, "--offline", "--status-cache", str(status_file), "--quiet"]).encode(),
                                    capture_output=True, timeout=20)
        if result.returncode:
            raise ValueError("Regeneration failed; run pi-regen to inspect configuration")
        if [read_owned(p, 8 * 1024 * 1024, missing=True) for p in inputs] != contents:
            raise ValueError("Catalog changed during regeneration; retrying at next prompt")
        after = read_owned(launcher, 2 * 1024 * 1024)
        model_after = read_owned(models, 8 * 1024 * 1024, missing=True) if models else b""
        stamp = hashlib.sha256(after + b"\0" + b"\0".join(contents) + b"\0" + model_after).hexdigest()
        if poll is not None:
            print(stamp)
        else:
            print("Pi shortcuts refreshed from configured local metadata (no service/model calls).")
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        if poll == stamp:
            return 0
        if poll is not None:
            print(stamp)
        message = str(exc) if isinstance(exc, EditedModels) else "Pi shortcut refresh failed; saved outputs were not sourced. Run pi-regen or setup to inspect configuration."
        print(message, file=sys.stderr)
        return 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--launcher", type=Path, required=True)
    parser.add_argument("--poll", help="Previous input fingerprint; no output when unchanged")
    args = parser.parse_args()
    fd = None
    if args.poll is not None:
        # Never refresh halfway through an explicit setup/update in another shell.
        lock = Path.home() / ".config/pi-shared/update.lock"
        try:
            fd = os.open(lock, os.O_RDONLY | os.O_NOFOLLOW)
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                os.close(fd)
                return 1
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(fd)
                return 0
        except FileNotFoundError:
            pass
        except OSError:
            if fd is not None:
                os.close(fd)
            return 1
    try:
        return refresh(args.launcher.expanduser(), args.poll)
    finally:
        if fd is not None:
            os.close(fd)


if __name__ == "__main__":
    sys.exit(main())
