# Runtime/local artifacts
.DS_Store
*.log
node_modules/

# Do not store secrets or machine-local pi state here
auth.json
settings.json
models.json
sessions/
git/
npm/
bin/*
!bin/pi-vanilla
!bin/pi-omlx-repair

# Per-project Pi config (e.g. .pi/enterprise-tools.json) is local-only;
# pi-shared travels by git and should not carry per-machine activation state.
.pi/
