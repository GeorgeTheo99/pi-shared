# Runtime/local artifacts
.DS_Store
*.log
node_modules/

# Do not store secrets or machine-local pi state here
auth.json
settings.json
models.json
sessions/
git/
npm/
bin/*
!bin/pi-vanilla
!bin/pi-omlx-repair
!bin/pi-catalog
!bin/pi-shared-install

# Per-project Pi config (e.g. .pi/enterprise-tools.json) is local-only;
# pi-shared travels by git and should not carry per-machine activation state.
.pi/
__pycache__/

# Copyrighted book PDFs are never committed; kb_search indexes markdown only.
knowledge/software-engineering/corpus/pdf-downloads/
*.pdf
