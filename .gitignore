# Per-project Pi config (e.g. .pi/enterprise-tools.json) is local-only;
# pi-shared travels by git and should not carry per-machine activation state.
.pi/
__pycache__/

# Private book originals, recovery records, and extracted text never ship in Git.
knowledge/software-engineering/corpus/pdf-downloads/
knowledge/software-engineering/private/
*.pdf
