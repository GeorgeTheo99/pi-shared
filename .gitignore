# Runtime/local artifacts
.DS_Store
*.log
node_modules/

# Do not store secrets or machine-local pi state here
auth.json
settings.json
models.json
.env
.env.*
*.env
*.env.*
!*.env.example
!*.env.*.example
*.p8
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
secrets*.yaml
secrets*.yml
.npmrc
.pypirc
.netrc
sessions/
git/
npm/
bin/*
!bin/pi-vanilla
!bin/pi-omlx-repair
!bin/pi-catalog
!bin/pi-shared-install
!bin/pi-shared-check-deps
!bin/pi-profile-check
!bin/pi-browser-check
