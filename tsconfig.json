{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./tools/typecheck/node_modules/@types"
    ],
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "./tools/typecheck/node_modules/@earendil-works/pi-coding-agent"
      ],
      "@earendil-works/pi-ai/compat": [
        "./tools/typecheck/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/pi-ai/dist/compat.d.ts"
      ],
      "@earendil-works/*": [
        "./tools/typecheck/node_modules/@earendil-works/pi-coding-agent/node_modules/@earendil-works/*"
      ],
      "typebox": [
        "./tools/typecheck/node_modules/@earendil-works/pi-coding-agent/node_modules/typebox"
      ]
    }
  },
  "include": [
    "extensions/**/*.ts"
  ],
  "exclude": [
    "extensions/*/node_modules",
    "extensions/**/*.test.ts"
  ]
}
