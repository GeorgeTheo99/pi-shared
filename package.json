{
  "name": "pi-shared",
  "private": true,
  "scripts": {
    "test": "npm run test:websearch && npm run test:goal && npm run test:ask-user && npm run test:self-handoff && npm run test:tool-summary && npm run test:panel && npm run test:subagents && npm run test:session-coordinator && npm run test:powerpoint",
    "test:websearch": "node --no-warnings --test tests/websearch_mcp_client.test.mts",
    "test:goal": "node --no-warnings --experimental-loader ./tests/fixtures/goal_test_loader.mjs --test tests/goal_abort.test.mts",
    "test:ask-user": "node --no-warnings --experimental-loader ./tests/fixtures/ask_user_test_loader.mjs --test tests/ask_user.test.mts",
    "test:self-handoff": "node --no-warnings --test tests/self_handoff.test.mts",
    "test:tool-summary": "node --no-warnings --test tests/tool_summary_policy.test.mts && node --no-warnings --experimental-loader ./tests/fixtures/tool_summary_test_loader.mjs --test tests/tool_summary_extension.test.mts",
    "test:panel": "node --no-warnings --experimental-loader ./tests/fixtures/panel_test_loader.mjs --test tests/panel_models.test.mts",
    "test:subagents": "node --no-warnings --experimental-loader ./tests/fixtures/subagent_test_loader.mjs --test tests/subagent_*.test.mts",
    "test:session-coordinator": "node --no-warnings --test tests/session_coordinator_state.test.mts && node --no-warnings --experimental-loader ./tests/fixtures/session_coordinator_test_loader.mjs --test tests/session_coordinator_extension.test.mts",
    "test:powerpoint": "node --no-warnings --test tests/powerpoint_skill.test.mjs"
  },
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  }
}
